@startuml
title F001 WAV playback — current implementation
start
partition "CLI — main()" {
    if (Exactly --device PCM and path, both nonempty?) then (yes)
        :Call play_wav_file(path, pcm_device);
    else (no)
        :Print usage to stderr and return 2;
        stop
    endif
}

partition "Playback module — play_wav_file()" {
    if (PCM name empty?) then (yes)
        :Return open PCM diagnostic;
        :CLI prints diagnostic and returns 1;
        stop
    endif
    :Check regular file and open with sf_open;
    if (File check or open failed?) then (yes)
        :Return open WAV diagnostic;
        :CLI prints diagnostic and returns 1;
        stop
    endif
    :validate_wav_format(info) checks little-endian
    RIFF/WAVE PCM16, channels, rate and frame count;
    if (Validation failed?) then (yes)
        :Release WAV handle;
        :CLI prints validation diagnostic and returns 1;
        stop
    endif
    :snd_pcm_open selects the caller's ALSA PCM
    in blocking playback mode;
    if (PCM open failed?) then (yes)
        :Release WAV handle;
        :CLI prints open PCM diagnostic and returns 1;
        stop
    endif
    :snd_pcm_set_params requests interleaved native-endian S16,
    source rate and channels, and 200 ms latency;
    if (PCM configuration failed?) then (yes)
        :Release PCM and WAV handles;
        :CLI prints configure PCM diagnostic and returns 1;
        stop
    endif

    :snd_pcm_get_params reads the negotiated period;
    if (Query failed or period is zero?) then (yes)
        :Release PCM and WAV handles;
        :CLI prints read PCM parameters diagnostic and returns 1;
        stop
    endif

    partition "transfer_frames()" {
        :Use the negotiated period as the chunk size;
        :Validate the sample count and allocate
        one reusable period buffer;
        if (Period too large or allocation failed?) then (yes)
            :Return PCM parameter or allocation diagnostic;
            :Attempt PCM drop and release handles;
            :CLI prints diagnostic and returns 1;
            stop
        endif
        while (Unread WAV frames?) is (yes)
            :sf_readf_short reads up to one period
            into the interleaved sample buffer;
            if (Decoder error or short read?) then (yes)
                :Return read WAV diagnostic to play_wav_file;
                :Attempt PCM drop and release handles;
                :CLI prints diagnostic and returns 1;
                stop
            endif
            if (Final chunk is incomplete?) then (yes)
                :Zero-fill only the unused frames
                in this period;
            endif
            :write_frames submits one complete period,
            advancing by frames written times channels;
            if (Negative write or zero progress?) then (yes)
                :Return write PCM diagnostic to play_wav_file;
                :Attempt PCM drop and release handles;
                :CLI prints diagnostic and returns 1;
                stop
            endif
            :Subtract the decoded WAV frames from unread count;
        endwhile (no)
    }

    :snd_pcm_drain waits after the last submitted chunk;
    if (Drain failed?) then (yes)
        :Attempt PCM drop and release handles;
        :CLI prints drain PCM diagnostic and returns 1;
        stop
    endif
    :Release PCM and WAV handles and return success;
}
:CLI returns 0;
stop
@enduml
